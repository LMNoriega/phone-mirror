#!/usr/bin/env python3
"""
phone-mirror-prompt - Diálogo de conexión y emparejamiento inalámbrico
Soporta:
1. Detección automática instantánea vía mDNS (Android Wireless Debugging).
2. Conexión manual por IP.
3. Emparejamiento por código de 6 dígitos (adb pair).
"""

import os
import sys
import socket
import subprocess
import threading
import time
from PyQt6.QtWidgets import (
    QApplication, QWidget, QVBoxLayout, QHBoxLayout,
    QLabel, QLineEdit, QPushButton, QFrame
)
from PyQt6.QtCore import Qt, pyqtSignal, QObject
from PyQt6.QtGui import QIntValidator, QFont

CONFIG_DIR = os.path.expanduser("~/.config/phone-mirror")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config")


def load_config():
    ip = "192.168.0.216"
    port = "5555"
    if os.path.isfile(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("PHONE_IP="):
                        ip = line.split("=", 1)[1].strip('"\' ')
                    elif line.startswith("PHONE_PORT="):
                        port = line.split("=", 1)[1].strip('"\' ')
        except Exception:
            pass
    return ip, port


def save_config(ip, port):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        f.write(f'# Configuration for phone-mirror\nPHONE_IP="{ip}"\nPHONE_PORT="{port}"\n')


class WorkerSignals(QObject):
    status = pyqtSignal(str)
    success = pyqtSignal(str)
    failure = pyqtSignal(str)


class ConnectPrompt(QWidget):
    def __init__(self, current_ip, current_port):
        super().__init__()
        self.current_ip = current_ip
        self.current_port = current_port
        self.signals = WorkerSignals()
        self.signals.status.connect(self.on_status)
        self.signals.success.connect(self.on_connect_success)
        self.signals.failure.connect(self.on_connect_failure)

        parts = current_ip.split(".")
        if len(parts) == 4:
            self.base_subnet = ".".join(parts[:3]) + "."
            self.suffix = parts[3]
        else:
            self.base_subnet = "192.168.0."
            self.suffix = "216"

        self.init_ui()
        # Intentar auto-detección por mDNS inmediatamente al abrir
        threading.Thread(target=self._auto_scan_on_launch, daemon=True).start()

    def init_ui(self):
        self.setWindowTitle("Conectar Teléfono")
        self.setObjectName("phone-mirror-prompt")
        self.setFixedWidth(440)
        self.setWindowFlags(Qt.WindowType.Dialog)

        self.setStyleSheet("""
            QWidget#phone-mirror-prompt {
                background-color: #171318;
                border: 1px solid #4a3e4e;
                border-radius: 14px;
            }
            QLabel {
                color: #eae0e7;
                font-family: 'JetBrains Mono', sans-serif;
            }
            QLineEdit {
                background-color: #241e26;
                color: #eae0e7;
                border: 1px solid #4a3e4e;
                border-radius: 8px;
                padding: 6px 10px;
                font-size: 14px;
                font-family: 'JetBrains Mono', monospace;
                font-weight: bold;
            }
            QLineEdit:focus {
                border: 1px solid #e9b5ef;
                background-color: #2b232e;
            }
            QPushButton {
                background-color: #2d2430;
                color: #eae0e7;
                border: 1px solid #4a3e4e;
                border-radius: 8px;
                padding: 7px 14px;
                font-size: 12px;
                font-family: 'JetBrains Mono', sans-serif;
                font-weight: 600;
            }
            QPushButton:hover {
                background-color: #3b3040;
                border: 1px solid #e9b5ef;
            }
            QPushButton#btnConnect {
                background-color: #e9b5ef;
                color: #1a111c;
                border: 1px solid #e9b5ef;
                font-weight: bold;
            }
            QPushButton#btnConnect:hover {
                background-color: #f3cbf8;
            }
            QPushButton#btnConnect:disabled {
                background-color: #524153;
                color: #8c7f8e;
                border: 1px solid #524153;
            }
            QPushButton#btnScan {
                background-color: #221c24;
                color: #e9b5ef;
                border: 1px solid rgba(233, 181, 239, 0.4);
            }
            QPushButton#btnScan:hover {
                background-color: #2e2432;
                border-color: #e9b5ef;
            }
        """)

        layout = QVBoxLayout()
        layout.setContentsMargins(22, 18, 22, 18)
        layout.setSpacing(12)

        # Header
        title_label = QLabel("📱  Conexión Inalámbrica (S24 Ultra)")
        font_title = QFont("JetBrains Mono", 12, QFont.Weight.Bold)
        title_label.setFont(font_title)
        layout.addWidget(title_label)

        sub_label = QLabel("Asegúrate de que 'Depuración inalámbrica' esté activa en tu teléfono:")
        sub_label.setStyleSheet("color: #b0a3af; font-size: 11px;")
        sub_label.setWordWrap(True)
        layout.addWidget(sub_label)

        # Botón de auto-detección rápida vía mDNS
        self.btn_scan = QPushButton("🔍 Auto-detectar teléfono en la red (mDNS)")
        self.btn_scan.setObjectName("btnScan")
        self.btn_scan.clicked.connect(self.start_scan)
        layout.addWidget(self.btn_scan)

        # Separador visual
        sep = QFrame()
        sep.setFrameShape(QFrame.Shape.HLine)
        sep.setStyleSheet("color: #362e38; margin: 4px 0;")
        layout.addWidget(sep)

        # Fila de IP manual
        manual_label = QLabel("O ingresá los últimos dígitos de la IP:")
        manual_label.setStyleSheet("color: #b0a3af; font-size: 11px;")
        layout.addWidget(manual_label)

        ip_row = QHBoxLayout()
        ip_row.setSpacing(6)

        prefix_label = QLabel(self.base_subnet)
        prefix_label.setStyleSheet("""
            background-color: #241e26;
            color: #b0a3af;
            border: 1px solid #4a3e4e;
            border-radius: 8px;
            padding: 6px 12px;
            font-size: 14px;
            font-family: 'JetBrains Mono', monospace;
            font-weight: bold;
        """)
        ip_row.addWidget(prefix_label)

        self.suffix_input = QLineEdit(self.suffix)
        self.suffix_input.setValidator(QIntValidator(1, 254))
        self.suffix_input.setMaxLength(3)
        self.suffix_input.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.suffix_input.returnPressed.connect(self.start_connect)
        ip_row.addWidget(self.suffix_input)

        layout.addLayout(ip_row)

        # Sección colapsable para emparejar con código (Pairing Code)
        self.pair_container = QWidget()
        pair_layout = QVBoxLayout(self.pair_container)
        pair_layout.setContentsMargins(0, 4, 0, 0)
        pair_layout.setSpacing(8)

        pair_title = QLabel("🔑 Emparejamiento por código (Ajustes > Depuración inalámbrica):")
        pair_title.setStyleSheet("color: #e9b5ef; font-size: 11px; font-weight: bold;")
        pair_layout.addWidget(pair_title)

        pair_inputs = QHBoxLayout()
        pair_inputs.setSpacing(6)

        self.pair_host_input = QLineEdit(f"{self.current_ip}:")
        self.pair_host_input.setPlaceholderText("IP:Puerto")
        self.pair_host_input.setStyleSheet("font-size: 12px; padding: 4px 8px;")
        pair_inputs.addWidget(self.pair_host_input, 3)

        self.pair_code_input = QLineEdit()
        self.pair_code_input.setPlaceholderText("Código (6 dígitos)")
        self.pair_code_input.setValidator(QIntValidator(100000, 999999))
        self.pair_code_input.setMaxLength(6)
        self.pair_code_input.setStyleSheet("font-size: 12px; padding: 4px 8px;")
        pair_inputs.addWidget(self.pair_code_input, 2)

        self.btn_do_pair = QPushButton("Emparejar")
        self.btn_do_pair.clicked.connect(self.start_pairing)
        pair_inputs.addWidget(self.btn_do_pair, 2)

        pair_layout.addLayout(pair_inputs)
        self.pair_container.setVisible(False)
        layout.addWidget(self.pair_container)

        self.btn_toggle_pair = QPushButton("▸ ¿Primer emparejamiento? Ingresar código")
        self.btn_toggle_pair.setStyleSheet("background: transparent; border: none; color: #b0a3af; font-size: 10px; text-align: left; padding: 0;")
        self.btn_toggle_pair.clicked.connect(self.toggle_pair_view)
        layout.addWidget(self.btn_toggle_pair)

        # Status label
        self.status_label = QLabel("")
        self.status_label.setStyleSheet("color: #ffb4ab; font-size: 11px;")
        self.status_label.setWordWrap(True)
        layout.addWidget(self.status_label)

        # Buttons
        btn_row = QHBoxLayout()
        btn_row.setSpacing(10)
        btn_row.addStretch()

        self.btn_cancel = QPushButton("Cancelar")
        self.btn_cancel.clicked.connect(self.close)
        btn_row.addWidget(self.btn_cancel)

        self.btn_connect = QPushButton("Conectar")
        self.btn_connect.setObjectName("btnConnect")
        self.btn_connect.clicked.connect(self.start_connect)
        btn_row.addWidget(self.btn_connect)

        layout.addLayout(btn_row)
        self.setLayout(layout)

        self.suffix_input.setFocus()
        self.suffix_input.selectAll()

    def keyPressEvent(self, event):
        if event.key() == Qt.Key.Key_Escape:
            self.close()
        else:
            super().keyPressEvent(event)

    def toggle_pair_view(self):
        visible = not self.pair_container.isVisible()
        self.pair_container.setVisible(visible)
        self.btn_toggle_pair.setText("▾ Ocultar emparejamiento" if visible else "▸ ¿Primer emparejamiento? Ingresar código")
        self.adjustSize()

    def on_status(self, msg):
        self.status_label.setStyleSheet("color: #e9b5ef; font-size: 11px;")
        self.status_label.setText(msg)

    def _auto_scan_on_launch(self):
        time.sleep(0.3)
        self._try_scan_and_connect(silent_failure=True)

    def start_scan(self):
        self.on_status("Buscando teléfono vía mDNS / Wireless Debugging...")
        self.set_controls_enabled(False)
        threading.Thread(target=self._try_scan_and_connect, args=(False,), daemon=True).start()

    def _try_scan_and_connect(self, silent_failure=False):
        try:
            mdns = subprocess.run(
                ["avahi-browse", "-r", "-t", "_adb-tls-connect._tcp", "--resolve", "-p", "-d", "local"],
                capture_output=True, text=True, timeout=2.0
            )
            disc_ip, disc_port = None, None
            for line in mdns.stdout.splitlines():
                parts = line.split(";")
                if len(parts) >= 9 and parts[0] == "=" and parts[2] == "IPv4":
                    disc_ip = parts[7]
                    disc_port = parts[8]
                    break

            if disc_ip and disc_port:
                self.signals.status.emit(f"Detectado S24 Ultra en {disc_ip}:{disc_port}. Activando modo inalámbrico...")
                # Connect to dynamic port and enable tcpip 5555
                subprocess.run(["adb", "connect", f"{disc_ip}:{disc_port}"], capture_output=True, timeout=2.0)
                time.sleep(0.2)
                subprocess.run(["adb", "-s", f"{disc_ip}:{disc_port}", "tcpip", self.current_port], capture_output=True, timeout=2.0)
                time.sleep(0.4)
                subprocess.run(["adb", "disconnect", f"{disc_ip}:{disc_port}"], capture_output=True, timeout=1.0)
                # Now connect to 5555
                subprocess.run(["adb", "connect", f"{disc_ip}:{self.current_port}"], capture_output=True, timeout=2.0)
                self.signals.success.emit(disc_ip)
            else:
                if not silent_failure:
                    self.signals.failure.emit("No se detectó ningún teléfono con 'Depuración inalámbrica' activa en la red Wi-Fi.")
        except Exception as e:
            if not silent_failure:
                self.signals.failure.emit(f"Error en auto-detección: {e}")

    def start_pairing(self):
        host = self.pair_host_input.text().strip()
        code = self.pair_code_input.text().strip()
        if not host or not code:
            self.status_label.setText("Por favor ingresa IP:Puerto y el código de 6 dígitos.")
            return

        self.on_status(f"Emparejando con {host}...")
        self.set_controls_enabled(False)

        def _pair_worker():
            try:
                res = subprocess.run(["adb", "pair", host, code], capture_output=True, text=True, timeout=8.0)
                out = (res.stdout + " " + res.stderr).lower()
                if "successfully paired" in out or res.returncode == 0:
                    self.signals.status.emit("¡Emparejado con éxito! Buscando y conectando...")
                    # Now scan and connect
                    time.sleep(0.5)
                    self._try_scan_and_connect(silent_failure=False)
                else:
                    self.signals.failure.emit(f"Fallo de emparejamiento: {res.stdout.strip() or res.stderr.strip()}")
            except Exception as e:
                self.signals.failure.emit(f"Error al emparejar: {e}")

        threading.Thread(target=_pair_worker, daemon=True).start()

    def start_connect(self):
        suffix = self.suffix_input.text().strip()
        if not suffix:
            self.status_label.setText("Por favor ingresá los últimos dígitos.")
            return

        new_ip = f"{self.base_subnet}{suffix}"
        self.on_status(f"Probando conexión con {new_ip}...")
        self.set_controls_enabled(False)

        threading.Thread(target=self._try_connect, args=(new_ip,), daemon=True).start()

    def _try_connect(self, new_ip):
        try:
            # 1. Fast socket check on port 5555
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(0.8)
            res = s.connect_ex((new_ip, int(self.current_port)))
            s.close()

            # If port 5555 is closed, attempt wireless debugging auto-setup for this IP
            if res != 0:
                self.signals.status.emit(f"Puerto {self.current_port} cerrado. Buscando Wireless Debugging...")
                mdns = subprocess.run(
                    ["avahi-browse", "-r", "-t", "_adb-tls-connect._tcp", "--resolve", "-p", "-d", "local"],
                    capture_output=True, text=True, timeout=2.0
                )
                disc_port = None
                for line in mdns.stdout.splitlines():
                    parts = line.split(";")
                    if len(parts) >= 9 and parts[0] == "=" and parts[2] == "IPv4":
                        if parts[7] == new_ip or not new_ip:
                            new_ip = parts[7]
                            disc_port = parts[8]
                            break

                if disc_port:
                    self.signals.status.emit(f"Detectado puerto {disc_port}. Activando puerto {self.current_port} vía Wi-Fi...")
                    subprocess.run(["adb", "connect", f"{new_ip}:{disc_port}"], capture_output=True, timeout=2.0)
                    time.sleep(0.2)
                    subprocess.run(["adb", "-s", f"{new_ip}:{disc_port}", "tcpip", self.current_port], capture_output=True, timeout=2.0)
                    time.sleep(0.4)
                    subprocess.run(["adb", "disconnect", f"{new_ip}:{disc_port}"], capture_output=True, timeout=1.0)
                else:
                    self.signals.failure.emit(f"No hay respuesta en {new_ip}:{self.current_port}. Asegúrate de activar 'Depuración inalámbrica'.")
                    return

            # 2. Connect via ADB
            subprocess.run(["adb", "disconnect", f"{new_ip}:{self.current_port}"], capture_output=True, timeout=1.5)
            subprocess.run(["adb", "connect", f"{new_ip}:{self.current_port}"], capture_output=True, timeout=2.0)

            # 3. Verify ADB state
            check = subprocess.run(["adb", "devices"], capture_output=True, text=True, timeout=1.5)
            is_connected = False
            for line in check.stdout.splitlines():
                if f"{new_ip}:{self.current_port}" in line and "device" in line:
                    is_connected = True
                    break

            if is_connected:
                self.signals.success.emit(new_ip)
            else:
                self.signals.failure.emit(f"Conectado a {new_ip}, pero ADB no autorizó la conexión.")
        except Exception as e:
            self.signals.failure.emit(f"Error: {str(e)}")

    def set_controls_enabled(self, enabled: bool):
        self.btn_connect.setEnabled(enabled)
        self.btn_cancel.setEnabled(enabled)
        self.btn_scan.setEnabled(enabled)
        self.suffix_input.setEnabled(enabled)
        self.btn_do_pair.setEnabled(enabled)

    def on_connect_success(self, new_ip):
        save_config(new_ip, self.current_port)
        subprocess.Popen([
            "scrcpy",
            "-s", f"{new_ip}:{self.current_port}",
            "--window-title=Phone Mirror",
            "--window-borderless",
            "--stay-awake",
            "--shortcut-mod=lalt"
        ])
        self.close()

    def on_connect_failure(self, error_msg):
        self.status_label.setStyleSheet("color: #ffb4ab; font-size: 11px;")
        self.status_label.setText(error_msg)
        self.set_controls_enabled(True)
        self.suffix_input.setFocus()
        self.suffix_input.selectAll()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("phone-mirror-prompt")
    app.setDesktopFileName("phone-mirror-prompt")

    ip, port = load_config()
    window = ConnectPrompt(ip, port)
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
